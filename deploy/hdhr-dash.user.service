# HDHR Dash - sample systemd unit (rootless Podman)
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/hdhr-dash.user.service ~/.config/systemd/user/hdhr-dash.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now hdhr-dash.service
#   sudo loginctl enable-linger "$USER"    # keep it running after logout / start at boot
#
# Ports below 1024 need net.ipv4.ip_unprivileged_port_start lowered when rootless.
# For .local (mDNS) name resolution, replace the "-p ..." line with "--network host \".

[Unit]
Description=HDHR Dash (HDHomeRun dashboard)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=%t/containers

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
Environment=HDHR_IMAGE=ghcr.io/kpirnie/hdhr-dash:latest
Environment=HDHR_PORT=8443
Environment=HDHR_HTTP=false
Restart=on-failure
TimeoutStopSec=30
ExecStart=/usr/bin/podman run \
    --cidfile=%t/%n.ctr-id \
    --cgroups=no-conmon \
    --rm \
    --sdnotify=conmon \
    --replace \
    -d \
    --name hdhr-dash \
    -p ${HDHR_PORT}:${HDHR_PORT} \
    -e HDHR_PORT=${HDHR_PORT} \
    -e HDHR_HTTP=${HDHR_HTTP} \
    -v hdhr-dash-certs:/certs \
    ${HDHR_IMAGE}
ExecStop=/usr/bin/podman stop --ignore -t 10 --cidfile=%t/%n.ctr-id
ExecStopPost=/usr/bin/podman rm -f --ignore -t 10 --cidfile=%t/%n.ctr-id
Type=notify
NotifyAccess=all

[Install]
WantedBy=default.target